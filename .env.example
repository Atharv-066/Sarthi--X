# Copy this file to ".env" and fill in the values from:
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
# (These are the *web app* config values. Do NOT put service-account / private_key values here.)
# After editing .env, restart `npm run dev` (Vite reads it only at start).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Bhashini (Marathi / Hindi translation) ---
# From your Bhashini / ULCA account (Profile -> API keys). Both values are needed.
VITE_BHASHINI_USER_ID=
VITE_BHASHINI_API_KEY=
