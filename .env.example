# Copy this file to ".env" and fill in the values from:
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
# (These are the *web app* config values. Do NOT put service-account / private_key values here.)
# After editing .env, restart `npm run dev` (Vite reads it only at start).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Translation (Marathi / Hindi) ---
# Nothing to fill in: translation needs NO API key.
# OPTIONAL: your own translation proxy (see README, section 5). Leave empty to use the built-in free providers.
# VITE_TRANSLATE_ENDPOINT=https://<region>-<project>.cloudfunctions.net/translate
